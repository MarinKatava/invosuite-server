<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.26.xsd">

    <!--
        Column types are Liquibase's portable/abstract types on purpose: the
        same changesets run against Oracle (production/docker-compose) and H2
        (the "test" Spring profile). Liquibase maps them to each dialect's
        native type, e.g. BOOLEAN -> Oracle NUMBER(1), BIGINT autoIncrement
        -> Oracle GENERATED BY DEFAULT AS IDENTITY, CLOB -> Oracle CLOB.
        All object names are kept at or under 28 characters for compatibility
        with Oracle's pre-12.2 30-byte identifier limit.
    -->

    <changeSet id="001-users" author="invoisuite">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_users"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_email"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)"/>
            <column name="full_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="auth_provider" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="google_sub" type="VARCHAR(255)">
                <constraints unique="true" uniqueConstraintName="uk_users_google_sub"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-companies" author="invoisuite">
        <createTable tableName="companies">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_companies"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_companies_owner"
                             references="users(id)" deleteCascade="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="address_line" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="postal_code" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="registration_number" type="VARCHAR(120)"/>
            <column name="vat_id" type="VARCHAR(120)"/>
            <column name="bank_name" type="VARCHAR(255)"/>
            <column name="iban" type="VARCHAR(64)"/>
            <column name="bic" type="VARCHAR(32)"/>
            <column name="default_currency" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="default_vat_percent" type="DECIMAL(5,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="vat_exempt_text" type="VARCHAR(500)"/>
            <column name="invoicing_place" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="companies" indexName="idx_companies_owner">
            <column name="owner_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-clients" author="invoisuite">
        <createTable tableName="clients">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_clients"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_clients_company"
                             references="companies(id)" deleteCascade="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="address_line" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="vat_id" type="VARCHAR(120)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="clients" indexName="idx_clients_company">
            <column name="company_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="004-projects" author="invoisuite">
        <createTable tableName="projects">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_projects"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_projects_company"
                             references="companies(id)" deleteCascade="true"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_projects_client"
                             references="clients(id)"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="default_unit" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="default_rate" type="DECIMAL(12,2)"/>
            <column name="currency" type="VARCHAR(10)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="projects" indexName="idx_projects_company">
            <column name="company_id"/>
        </createIndex>

        <!-- ON DELETE SET NULL isn't expressible via the inline constraints
             tag; add it explicitly so removing a client doesn't orphan the
             foreign key value on projects that reference it. -->
        <dropForeignKeyConstraint baseTableName="projects" constraintName="fk_projects_client"/>
        <addForeignKeyConstraint baseTableName="projects" baseColumnNames="client_id"
                                  constraintName="fk_projects_client"
                                  referencedTableName="clients" referencedColumnNames="id"
                                  onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="005-invoices" author="invoisuite">
        <createTable tableName="invoices">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_invoices"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_invoices_company"
                             references="companies(id)" deleteCascade="true"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_invoices_client"
                             references="clients(id)"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_number" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="issue_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_start" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_date" type="DATE"/>
            <column name="invoicing_place" type="VARCHAR(255)"/>
            <column name="currency" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="vat_percent" type="DECIMAL(5,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="vat_exempt_text" type="VARCHAR(500)"/>
            <column name="notes" type="CLOB"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="issuer_snapshot" type="CLOB"/>
            <column name="client_snapshot" type="CLOB"/>
            <column name="net_total" type="DECIMAL(14,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="vat_amount" type="DECIMAL(14,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total" type="DECIMAL(14,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="invoices" indexName="idx_invoices_company">
            <column name="company_id"/>
        </createIndex>
        <createIndex tableName="invoices" indexName="idx_invoices_client">
            <column name="client_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="006-invoice-items" author="invoisuite">
        <createTable tableName="invoice_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_invoice_items"/>
            </column>
            <column name="invoice_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_items_invoice"
                             references="invoices(id)" deleteCascade="true"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_items_project"
                             references="projects(id)"/>
            </column>
            <column name="project_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="unit" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="line_total" type="DECIMAL(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="invoice_items" indexName="idx_items_invoice">
            <column name="invoice_id"/>
        </createIndex>

        <dropForeignKeyConstraint baseTableName="invoice_items" constraintName="fk_items_project"/>
        <addForeignKeyConstraint baseTableName="invoice_items" baseColumnNames="project_id"
                                  constraintName="fk_items_project"
                                  referencedTableName="projects" referencedColumnNames="id"
                                  onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
